<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_pos_closing_sales" model="mail.template">
            <field name="name">POS : Rapport de clôture de caisse</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="subject">Clôture de caisse {{ object.name }} - {{ object.config_id.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="report_template_ids" eval="[(4, ref('point_of_sale.sale_details_report'))]"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333;">
    <p>Bonjour,</p>
    <p>
        La session de caisse <strong t-out="object.name or ''"></strong> vient d'être clôturée.
    </p>

    <table style="border-collapse: collapse; width: 100%; max-width: 480px; margin: 12px 0;">
        <tbody>
            <tr>
                <td style="padding: 6px 12px; font-weight: bold; width: 40%;">Société</td>
                <td style="padding: 6px 12px;">
                    <span t-out="object.company_id.name or ''"></span>
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 12px; font-weight: bold; width: 40%;">Point de vente</td>
                <td style="padding: 6px 12px;">
                    <span t-out="object.config_id.name or ''"></span>
                </td>
            </tr>
            <tr>
                <td style="padding: 6px 12px; font-weight: bold;">Date et heure de clôture</td>
                <td style="padding: 6px 12px;">
                    <span t-out="object.closing_datetime_display or ''"></span>
                </td>
            </tr>
        </tbody>
    </table>

    <table style="border-collapse: collapse; width: 100%; max-width: 480px; margin: 12px 0;">
        <tbody>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #dddddd;">Ventes en caisse (POS)</td>
                <td style="padding: 8px 12px; border: 1px solid #dddddd; text-align: right;">
                    <span t-out="'%.2f' % object.pos_sales_total"></span>
                    <span t-out="object.currency_id.symbol or ''"></span>
                </td>
            </tr>
            <tr>
                <td style="padding: 8px 12px; border: 1px solid #dddddd;">Ventes normales (factures)</td>
                <td style="padding: 8px 12px; border: 1px solid #dddddd; text-align: right;">
                    <span t-out="'%.2f' % object.normal_sales_total"></span>
                    <span t-out="object.currency_id.symbol or ''"></span>
                </td>
            </tr>
            <tr style="font-weight: bold; background-color: #f5f5f5;">
                <td style="padding: 8px 12px; border: 1px solid #dddddd;">Total global</td>
                <td style="padding: 8px 12px; border: 1px solid #dddddd; text-align: right;">
                    <span t-out="'%.2f' % object.grand_total"></span>
                    <span t-out="object.currency_id.symbol or ''"></span>
                </td>
            </tr>
        </tbody>
    </table>

    <p style="margin-top: 20px; color: #888888; font-size: 12px;">
        Cet email a été généré automatiquement à la clôture de la session de caisse.
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
