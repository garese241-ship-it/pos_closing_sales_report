<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulaire de paramétrage autonome : ne s'accroche à aucune vue existante,
         donc aucun risque de casser à cause d'un changement de structure interne
         de la vue des paramètres généraux. -->
    <record id="view_form_pos_closing_sales_report_settings" model="ir.ui.view">
        <field name="name">pos.closing.sales.report.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Rapport de clôture de caisse">
                <header>
                    <button string="Enregistrer" type="object" name="execute" class="btn-primary"/>
                    <button string="Ignorer" type="object" name="cancel" class="btn-secondary" special="cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Rapport de clôture de caisse</h1>
                    </div>
                    <group>
                        <field name="pos_closing_report_user_id"
                               string="Destinataire de l'email de clôture"/>
                    </group>
                    <p class="text-muted">
                        Cet utilisateur reçoit un email récapitulatif (ventes POS + ventes normales)
                        à chaque clôture d'une session de caisse. Laisser le champ vide désactive l'envoi.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_closing_sales_report_settings" model="ir.actions.act_window">
        <field name="name">Rapport de clôture de caisse</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="view_id" ref="view_form_pos_closing_sales_report_settings"/>
    </record>

    <!-- Menu dédié, indépendant de la structure interne du menu Point de Vente,
         visible uniquement par les managers POS. -->
    <menuitem id="menu_pos_closing_sales_report_root"
              name="Rapport de clôture caisse"
              sequence="99"
              groups="point_of_sale.group_pos_manager"/>

    <menuitem id="menu_pos_closing_sales_report_settings"
              name="Paramètres"
              parent="menu_pos_closing_sales_report_root"
              action="action_pos_closing_sales_report_settings"
              sequence="1"/>
</odoo>
